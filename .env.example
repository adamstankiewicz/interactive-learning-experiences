# --- Standards source: "learning-commons" (default) | "example" ---
# "example" needs no external service or API key — a tiny in-memory standards
# set covering math/science/ELA, useful for local dev or as a reference for
# wiring in a real second source (state standards, NGSS, a custom graph).
STANDARDS_SOURCE=learning-commons

# --- Persistence: "supabase" | "memory" ---
# Unset — Supabase if NEXT_PUBLIC_SUPABASE_URL/SUPABASE_SERVICE_ROLE_KEY are
# configured below, otherwise "memory" automatically: the app runs with zero
# persistence setup, state gone on restart. Local Supabase (recommended for
# anything beyond a quick demo): `pnpm db:start`, then `pnpm db:status` for
# the URL/keys below.
# STORAGE_ADAPTER=

# --- Demo roster fixtures: "1" to load them ---
# The in-memory adapter starts with an empty roster. Set this to seed the four
# demo students from `src/lib/roster/seed.ts`. Off by default because
# `GET /api/roster` is unauthenticated and the records carry accommodation
# notes, so a misconfigured deployment should not come up already populated.
# SEED_DEMO_ROSTER=1

# --- Learning Commons Knowledge Graph MCP (required when STANDARDS_SOURCE=learning-commons) ---
LEARNING_COMMONS_API_KEY=sk_prod_...
# Optional; defaults to https://mcp.learningcommons.org/mcp
# LEARNING_COMMONS_MCP_URL=

# --- Supabase (required when STORAGE_ADAPTER=supabase, or left unconfigured) ---
# NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# SUPABASE_SERVICE_ROLE_KEY=

# --- LLM provider: "anthropic" (default) | "openrouter" | "bedrock" ---
LLM_PROVIDER=openrouter

# Two model roles, both defaulting to the same model. Set *_SCORING_MODEL_ID
# to run the Draft Meter's per-keystroke scoring on a faster tier — worth
# measuring, but note that a faster model also grades a shade harsher.

# Option A — OpenRouter (one key, no cloud setup)
OPENROUTER_API_KEY=sk-or-v1-...
# OPENROUTER_MODEL_ID=anthropic/claude-opus-5
# OPENROUTER_SCORING_MODEL_ID=anthropic/claude-haiku-4.5   # optional, faster

# Option B — first-party Anthropic API
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL_ID=claude-opus-5
# ANTHROPIC_SCORING_MODEL_ID=claude-haiku-4-5-20251001   # optional, faster

# Option C — Claude on Amazon Bedrock
# AWS_BEARER_TOKEN_BEDROCK=      # Bedrock API key; omit to use SigV4 creds instead
# AWS_REGION=us-east-1
# BEDROCK_MODEL_ID=us.anthropic.claude-opus-5
# Optional, faster. Model access is per-account and per-region — enable it in
# the Bedrock console first, or scoring 403s on every keystroke.
# BEDROCK_SCORING_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
